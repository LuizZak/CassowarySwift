{
    "tasks": {
        "version": "2.0.0",
		"problemMatcher": [
			// Compilation
			{
				"owner": "swift",
				"fileLocation": "autoDetect",
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			},
			// Fix to detect unit test executions, which do not feature a column during reporting
			{
				"owner": "swift",
				"fileLocation": "autoDetect",
				"pattern": {
					"regexp": "^(.*):(\\d+):\\s+(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"severity": 3,
					"message": 4
				}
			}
		],
        "tasks": [
            {
                "label": "Build (debug)",
                "type": "shell",
                "command": "swift",
                "args": ["build"]
            },
            {
                "label": "Test",
                "type": "shell",
                "command": "swift",
                "args": ["test"]
            },
            {
                "label": "Test (performance)",
                "type": "shell",
                "command": "swift",
                "args": [
                    "test",
                    "-Xswiftc", "-DPERFORMANCE_TESTS"
                ]
            },
            {
                "label": "Report build time (debug)",
                "type": "shell",
                "command": "swift",
                "args": [
                    "build",
                    "--build-tests",
                    "-Xswiftc", "-driver-time-compilation",
                    "-Xswiftc", "-Xfrontend",
                    "-Xswiftc", "-warn-long-function-bodies=500",
                    "-Xswiftc", "-Xfrontend",
                    "-Xswiftc", "-warn-long-expression-type-checking=20"
                ]
            },
        ]
    },
    "folders": [
        {
            "path": ".",
            "name": "CassowarySwift"
        }
    ],
    "settings": {
		"files.eol": "\n",
		"files.trimTrailingWhitespace": true,
		"files.insertFinalNewline": true,
		"files.exclude": {
			".git": true,
			".build": true,
			".*.sw?": true,
			"**/.DS_Store": true
		},
        "commentAnchors.workspace.excludeFiles": "**/{node_modules,.git,.idea,target,out,build,vendor,.build,.swiftpm}/**/*",
		"commentAnchors.tags.list": [
			{
				"tag": "MARK:",
				"iconColor": "default",
				"highlightColor": "#A8C023",
				"scope": "file"
			},
			{
				"tag": "TODO:",
				"iconColor": "blue",
				"highlightColor": "#3ea8ff",
				"scope": "workspace"
			},
			{
				"tag": "FIXME:",
				"iconColor": "red",
				"highlightColor": "#F44336",
				"scope": "workspace"
			},
			{
				"tag": "NOTE:",
				"iconColor": "orange",
				"highlightColor": "#FFB300",
				"scope": "file"
			},
		],
		"ShortcutMenuBar.userButton01Command": "workbench.action.tasks.runTask|Build (debug)",
        "ShortcutMenuBar.userButton02Command": "workbench.action.tasks.runTask|Test",
        "ShortcutMenuBar.userButton03Command": "workbench.action.tasks.runTask|Test (performance)",
        "ShortcutMenuBar.userButton04Command": "workbench.action.tasks.runTask|Report build time (debug)",
        "cSpell.words": [
            "coeff",
            "errminus",
            "errplus",
            "Pivotable",
            "whitespaces",
            "Xfrontend",
            "Xswiftc"
        ],
    }
}
